# Copy to backend/.env.local, NOT .env. Set APP_ENV=local in the shell first.
APP_ENV=local
NODE_ENV=development
PORT=10000
MONGO_URI=mongodb://127.0.0.1:27017/cafe_qr_local
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
ADMIN_USERNAME=local-admin
# Generate independent local credentials privately. JWT must start with local- and be >=32 chars.
ADMIN_PASSWORD=
JWT_SECRET=
TELEGRAM_ENABLED=false
WEB_PUSH_ENABLED=false
PUSH_TEST_ENABLED=false
# Do not include TELEGRAM_*, VAPID_* credentials or remote Mongo settings in local config.
